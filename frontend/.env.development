# Defaults for `npm run dev` outside Docker. Override in .env.local; production values come from Vercel.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: Google Cloud project number for the Google Picker (Add → Google Drive), e.g. 123456789012.
# NEXT_PUBLIC_GOOGLE_APP_ID=
