# Intrv-embed configuration. Create your local .env with:  make env
# `make env` copies this file and replaces every __GENERATE_*__ token with fresh random values
# (the same token always gets the same value, so URLs and passwords stay consistent).
# Never commit .env. Full reference: docs/ARCHITECTURE.md §20 and docs/DEPLOYMENT.md.

# --- Application -----------------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true
PUBLIC_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
METRICS_ENABLED=true

# --- Postgres (compose creates roles app_owner + app_rw on first start) ----------------------
POSTGRES_ADMIN_PASSWORD=__GENERATE_POSTGRES_ADMIN__
APP_OWNER_DB_PASSWORD=__GENERATE_APP_OWNER_DB__
APP_RW_DB_PASSWORD=__GENERATE_APP_RW_DB__
DATABASE_URL=postgresql+asyncpg://app_rw:__GENERATE_APP_RW_DB__@postgres:5432/intrv
DATABASE_MIGRATION_URL=postgresql+asyncpg://app_owner:__GENERATE_APP_OWNER_DB__@postgres:5432/intrv

# --- Valkey (Redis-compatible) ---------------------------------------------------------------
VALKEY_PASSWORD=__GENERATE_VALKEY__
VALKEY_URL=redis://:__GENERATE_VALKEY__@valkey:6379/0

# --- Qdrant ----------------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=__GENERATE_QDRANT__

# --- S3-compatible object storage (dev: SeaweedFS; prod: Cloudflare R2 / AWS S3) --------------
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=intrv
S3_ACCESS_KEY=__GENERATE_S3_ACCESS__
S3_SECRET_KEY=__GENERATE_S3_SECRET__
S3_FORCE_PATH_STYLE=true
# Host that browsers use for download links (presigned URLs). Leave empty when it equals S3_ENDPOINT_URL.
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

# --- Secrets ---------------------------------------------------------------------------------
MASTER_KEY_BASE64=__GENERATE_MASTER_KEY_32B__
JWT_SECRET=__GENERATE_JWT_SECRET__
# On an empty database, create this org and email (or log) an owner invitation link to this address.
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_ORG_NAME="My Organization"
OWNER_BOOTSTRAP_ORG_SLUG=default

# --- Auth ------------------------------------------------------------------------------------
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_DAYS=30
INVITE_TTL_HOURS=168
ALLOW_ORG_SIGNUP=false

# --- Retrieval models (Phase 3) ----------------------------------------------------------------
# lite (default, CPU, no extra containers): fastembed + BAAI/bge-small-en-v1.5, models cached in MODELS_CACHE_DIR.
# quality (`--profile models`, or GPU TEI): EMBED_BACKEND=tei, EMBED_MODEL=BAAI/bge-m3, TEI_URL=http://tei-embed:80,
#   RERANK_BACKEND=tei, RERANK_MODEL=BAAI/bge-reranker-v2-m3, TEI_RERANK_URL=http://tei-rerank:80
# openai: any OpenAI-compatible /embeddings endpoint (EMBED_OPENAI_BASE_URL, EMBED_OPENAI_API_KEY).
# Changing the embedding model creates a new vector collection: reindex documents afterwards.
EMBED_BACKEND=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
TEI_URL=
EMBED_OPENAI_BASE_URL=
EMBED_OPENAI_API_KEY=
EMBED_BATCH_SIZE=32
RERANK_BACKEND=fastembed
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
TEI_RERANK_URL=
MODELS_CACHE_DIR=/models

# --- Ingestion (Phase 3) -------------------------------------------------------------------------
# auto: Docling when installed (better tables/layout), else the built-in parsers (+ RapidOCR for scans).
PARSER_BACKEND=auto
MAX_UPLOAD_MB=100
MAX_PAGES=2000
INGEST_TIMEOUT_S=900
# true: process uploads inside the API process instead of the Celery worker (single-process demos only).
INGEST_INLINE=false

# --- Agent engine / LLM (Phase 2+) -------------------------------------------------------------
ENGINE_TURN_MODE=auto
# true = self-host mode: the backend may call servers on private networks (Ollama, vLLM, llama-server on the
# Docker host) and SSRF protection is off for model endpoints. Keep false for any internet-facing deployment.
ALLOW_PRIVATE_LLM_ENDPOINTS=false
GGUF_ALLOWED_DIRS=
# llama.cpp server binary for GGUF_MANAGED models, and how long an unused model stays loaded
LLAMA_SERVER_BIN=llama-server
GGUF_IDLE_UNLOAD_S=900

# --- Connectors (Phase 4) ----------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# --- Voice interviews (docker compose --profile voice) -------------------------------------------
# Public URL of the voice worker (the browser POSTs its WebRTC offer there). Empty = voice disabled.
VOICE_PUBLIC_URL=
# TURN for candidates behind strict NATs: the bundled coturn uses TURN_SHARED_SECRET (short-lived credentials
# per interview). Example: TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SHARED_SECRET=__GENERATE_TURN_SHARED_SECRET__
TURN_REALM=intrv.local
STUN_URLS=stun:stun.l.google.com:19302
# Speech-to-text: faster_whisper (model baked into the voice image) | groq | openai_compatible
STT_BACKEND=faster_whisper
STT_LANGUAGE=en
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
GROQ_API_KEY=
WHISPER_DEVICE=cpu
TTS_VOICE=af_heart

# --- Email ---------------------------------------------------------------------------------------
# Dev: Mailpit catches all mail (UI at http://localhost:8025). Production: your SMTP provider + SMTP_TLS=starttls.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=none
MAIL_FROM="Intrv-embed <no-reply@intrv.local>"

# --- Practical rounds (Phase 8) ----------------------------------------------------------------
PISTON_URL=
RENODE_ENABLED=false

# --- Observability -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Frontend (also set these on Vercel; see docs/DEPLOYMENT.md §4.1) ---------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google Drive Picker (optional): the Google Cloud project *number*
NEXT_PUBLIC_GOOGLE_APP_ID=

# --- Production stack (make up-prod; docs/DEPLOYMENT.md §6) --------------------------------------
# DNS A records for these names must point at the server before the first start (Caddy gets the certificates).
API_DOMAIN=
FILES_DOMAIN=
# Only when the frontend runs on this server (profile "frontend") instead of Vercel:
APP_DOMAIN=
ACME_EMAIL=
API_WORKERS=2
WORKER_CONCURRENCY=2

# --- Backups (nightly; make backup-now runs one immediately) ---------------------------------------
BACKUP_HOUR_UTC=2
BACKUP_KEEP_DAYS=7
# An age public key (age-keygen -o backup-key.txt); keep the private key off the server.
BACKUP_AGE_RECIPIENT=
# Off-site copy (another provider or region than S3_ENDPOINT_URL): any S3-compatible bucket.
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=auto
